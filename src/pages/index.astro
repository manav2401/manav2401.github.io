---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../config';

// The homepage is one markdown file: src/content/pages/home.md — edit that,
// not this. Your name is the page's heading, so it sits here rather than in
// the header — which this page doesn't render at all.
const home = await getEntry('pages', 'home');

if (!home) {
  throw new Error('Missing src/content/pages/home.md — the homepage needs it.');
}

const { Content } = await render(home);
---

<Base>
  <h1>{site.name}</h1>
  <Content />
</Base>
