---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, formatShortDate } from '../../config';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Group by year so the list stays scannable as it grows.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}

const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Writing" description="Everything I've written.">
  <h1>Writing</h1>

  {
    posts.length === 0 && (
      <p>
        Nothing here yet. Add a markdown file to <code>src/content/writing/</code> and it
        will appear.
      </p>
    )
  }

  {
    years.map((year) => (
      <section class="year-group">
        <h2 class="year-heading">{year}</h2>
        <ul class="post-list">
          {byYear.get(year)!.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>
                {formatShortDate(post.data.date)}
              </time>
              <a href={url(`/writing/${post.id}`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
